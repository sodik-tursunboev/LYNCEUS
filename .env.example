# Copy to .env (git-ignored). Placeholders only: never commit real values.
LYNCEUS_LOG_LEVEL=INFO
LYNCEUS_DATABASE_URL=postgresql+psycopg://mirage:CHANGE_ME@127.0.0.1:5432/mirage?connect_timeout=5
POSTGRES_USER=mirage
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mirage
# Bearer token for the analysis API; the endpoint refuses to serve without one.
LYNCEUS_API_TOKEN=CHANGE_ME
# Same URL as above: enables the PostgreSQL variants of the migration tests.
# LYNCEUS_TEST_DATABASE_URL=
# Use 127.0.0.1, not localhost: Postgres binds IPv4 loopback only, and on Windows a connect to
# ::1 hangs instead of being refused. connect_timeout turns that kind of hang into a fast failure.

# Threat intelligence (M3). Everything is off until you name providers. Read docs/milestones/M3.md
# first: several providers allow personal, non-commercial use only. Placeholders only.
# Lists (downloaded and matched on this machine; nothing about your links is sent; the running core
# keeps them fresh by itself): openphish needs no key, phishtank works without one (slower refresh),
# urlhaus needs a free abuse.ch Auth-Key. Asking providers (send ONE registered domain name):
# virustotal and urlscan need a free key each; rdap needs none (domain age).
# LYNCEUS_INTEL_PROVIDERS=openphish,phishtank,urlhaus,virustotal,urlscan,rdap
# LYNCEUS_PHISHTANK_KEY=CHANGE_ME
# LYNCEUS_URLHAUS_AUTH_KEY=CHANGE_ME
# LYNCEUS_VIRUSTOTAL_API_KEY=CHANGE_ME
# LYNCEUS_URLSCAN_API_KEY=CHANGE_ME
# LYNCEUS_INTEL_EMAIL_LINKS=false

# A local language model that reads a macro's recovered code and gives ADVICE only (ADR-023).
# Ollama on this computer; any address that is not loopback stops start-up.
# LYNCEUS_LLM_REVIEW=false
# LYNCEUS_LLM_URL=http://127.0.0.1:11434
# LYNCEUS_LLM_MODEL=llama3.2:3b

# Live Gmail (M5, ADR-017). Create an OAuth client of type "Desktop app" in your own Google Cloud project,
# add yourself as a test user, then: python -m core.mailbox connect
# LYNCEUS_GMAIL_ENABLED=false
# LYNCEUS_GMAIL_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# LYNCEUS_GMAIL_CLIENT_SECRET=CHANGE_ME
# LYNCEUS_GMAIL_LOOKBACK_DAYS=2
# LYNCEUS_GMAIL_POLL_SECONDS=60

# Live Outlook / Microsoft 365 (M5b, ADR-017 addendum). Register an app in your own Azure tenant
# ("Mobile and desktop applications", redirect URI http://localhost, delegated Mail.Read, no secret),
# then: python -m core.mailbox connect --provider outlook
# LYNCEUS_OUTLOOK_ENABLED=false
# LYNCEUS_OUTLOOK_CLIENT_ID=CHANGE_ME
# LYNCEUS_OUTLOOK_TENANT=common
# LYNCEUS_OUTLOOK_LOOKBACK_DAYS=2
# LYNCEUS_OUTLOOK_POLL_SECONDS=60
