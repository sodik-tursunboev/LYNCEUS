# Copy to .env (git-ignored). Placeholders only: never commit real values.
MIRAGE_LOG_LEVEL=INFO
MIRAGE_DATABASE_URL=postgresql+psycopg://mirage:CHANGE_ME@127.0.0.1:5432/mirage?connect_timeout=5
POSTGRES_USER=mirage
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mirage
# Same URL as above: enables the PostgreSQL variants of the migration tests.
# MIRAGE_TEST_DATABASE_URL=
# Use 127.0.0.1, not localhost: Postgres binds IPv4 loopback only, and on Windows a connect to
# ::1 hangs instead of being refused. connect_timeout turns that kind of hang into a fast failure.
