{
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "AnalyzeResponse": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/UrlFlag"
            },
            "title": "Flags",
            "type": "array"
          },
          "normalized_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalized Url"
          },
          "persisted": {
            "title": "Persisted",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          }
        },
        "required": [
          "verdict",
          "evidence",
          "normalized_url",
          "flags",
          "reason",
          "persisted"
        ],
        "title": "AnalyzeResponse",
        "type": "object"
      },
      "Confidence": {
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH"
        ],
        "title": "Confidence",
        "type": "string"
      },
      "EmailResponse": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/LinkSummary"
            },
            "title": "Links",
            "type": "array"
          },
          "persisted": {
            "title": "Persisted",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MessageSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          }
        },
        "required": [
          "verdict",
          "evidence",
          "reason",
          "summary",
          "links",
          "persisted"
        ],
        "title": "EmailResponse",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "payload_ref": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payload Ref"
          },
          "sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "summary": {
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "summary"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LinkSummary": {
        "additionalProperties": false,
        "properties": {
          "flags": {
            "items": {
              "type": "string"
            },
            "title": "Flags",
            "type": "array"
          },
          "host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Host"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "normalized_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalized Url"
          },
          "part": {
            "title": "Part",
            "type": "string"
          },
          "risk_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "title": "Rules",
            "type": "array"
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerdictState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "part",
          "kind",
          "flags",
          "normalized_url",
          "host",
          "state",
          "risk_score",
          "rules"
        ],
        "title": "LinkSummary",
        "type": "object"
      },
      "MessageSummary": {
        "additionalProperties": false,
        "properties": {
          "attachments": {
            "title": "Attachments",
            "type": "integer"
          },
          "defects": {
            "items": {
              "type": "string"
            },
            "title": "Defects",
            "type": "array"
          },
          "limits_hit": {
            "items": {
              "type": "string"
            },
            "title": "Limits Hit",
            "type": "array"
          },
          "links": {
            "title": "Links",
            "type": "integer"
          },
          "links_analyzed": {
            "title": "Links Analyzed",
            "type": "integer"
          },
          "parts": {
            "title": "Parts",
            "type": "integer"
          },
          "relative_links_skipped": {
            "title": "Relative Links Skipped",
            "type": "integer"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          }
        },
        "required": [
          "size",
          "parts",
          "attachments",
          "links",
          "links_analyzed",
          "relative_links_skipped",
          "limits_hit",
          "defects"
        ],
        "title": "MessageSummary",
        "type": "object"
      },
      "ProviderResult": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "provenance": {
            "minLength": 1,
            "title": "Provenance",
            "type": "string"
          },
          "provider": {
            "minLength": 1,
            "title": "Provider",
            "type": "string"
          },
          "queried_at": {
            "format": "date-time",
            "title": "Queried At",
            "type": "string"
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerdictState"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ProviderStatus"
          }
        },
        "required": [
          "provider",
          "status",
          "queried_at",
          "latency_ms",
          "provenance"
        ],
        "title": "ProviderResult",
        "type": "object"
      },
      "ProviderStatus": {
        "enum": [
          "OK",
          "TIMEOUT",
          "ERROR",
          "RATE_LIMITED",
          "UNAVAILABLE"
        ],
        "title": "ProviderStatus",
        "type": "string"
      },
      "ResponseAction": {
        "description": "Never includes deletion: responses are reversible (CLAUDE.md rule 7).",
        "enum": [
          "NONE",
          "WARN",
          "BLOCK",
          "QUARANTINE"
        ],
        "title": "ResponseAction",
        "type": "string"
      },
      "Signal": {
        "additionalProperties": false,
        "properties": {
          "attack": {
            "anyOf": [
              {
                "pattern": "^T\\d{4}(\\.\\d{3})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attack"
          },
          "category": {
            "minLength": 1,
            "title": "Category",
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "rule_id": {
            "minLength": 1,
            "title": "Rule Id",
            "type": "string"
          },
          "weight": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "rule_id",
          "category",
          "weight",
          "description"
        ],
        "title": "Signal",
        "type": "object"
      },
      "UrlFlag": {
        "description": "Facts about how the input differed from its normalised form. Not verdicts.",
        "enum": [
          "SCHEME_ASSUMED",
          "REFANGED",
          "WHITESPACE_TRIMMED",
          "INTERIOR_WHITESPACE_REMOVED",
          "CONTROL_CHARS",
          "INVISIBLE_CHARS",
          "BACKSLASH",
          "TRAILING_DOT",
          "DEFAULT_PORT_ELIDED",
          "DOUBLE_ENCODED",
          "HOST_PERCENT_ENCODED",
          "USERINFO",
          "IDN",
          "PUNYCODE",
          "IP_OBFUSCATED",
          "IPV4_MAPPED",
          "NON_HTTP_SCHEME",
          "DANGEROUS_SCHEME"
        ],
        "title": "UrlFlag",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Verdict": {
        "additionalProperties": false,
        "properties": {
          "applied_response": {
            "$ref": "#/components/schemas/ResponseAction"
          },
          "artifact_id": {
            "format": "uuid",
            "title": "Artifact Id",
            "type": "string"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "engine_version": {
            "minLength": 1,
            "title": "Engine Version",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "explanation": {
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "provider_results": {
            "items": {
              "$ref": "#/components/schemas/ProviderResult"
            },
            "title": "Provider Results",
            "type": "array"
          },
          "recommended_response": {
            "$ref": "#/components/schemas/ResponseAction"
          },
          "risk_score": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score"
          },
          "ruleset_version": {
            "minLength": 1,
            "title": "Ruleset Version",
            "type": "string"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/Signal"
            },
            "title": "Signals",
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/VerdictState"
          }
        },
        "required": [
          "artifact_id",
          "state",
          "risk_score",
          "confidence",
          "signals",
          "evidence_ids",
          "provider_results",
          "recommended_response",
          "applied_response",
          "explanation",
          "engine_version",
          "ruleset_version"
        ],
        "title": "Verdict",
        "type": "object"
      },
      "VerdictState": {
        "enum": [
          "MALICIOUS",
          "SUSPICIOUS",
          "BENIGN",
          "UNKNOWN",
          "ERROR"
        ],
        "title": "VerdictState",
        "type": "string"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "MIRAGE",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/emails/analyze": {
      "post": {
        "operationId": "analyze_email_v1_emails_analyze_post",
        "requestBody": {
          "content": {
            "message/rfc822": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Analyze Email"
      }
    },
    "/v1/urls/analyze": {
      "post": {
        "operationId": "analyze_v1_urls_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Analyze"
      }
    }
  }
}
