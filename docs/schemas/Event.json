{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "A thing to analyse. Holds a hash and a locator, never raw email/file content.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "ref": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256",
        "ref"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "URL",
        "EMAIL",
        "FILE"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "EventSource": {
      "enum": [
        "BROWSER",
        "AGENT",
        "EMAIL",
        "API",
        "CORPUS"
      ],
      "title": "EventSource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    }
  },
  "required": [
    "source",
    "artifacts"
  ],
  "title": "Event",
  "type": "object"
}
