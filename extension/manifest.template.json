{
  "manifest_version": 3,
  "name": "MIRAGE",
  "description": "Warns before you open a page that looks like phishing. Works with the MIRAGE agent on this computer.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "__KEY__",
  "permissions": ["nativeMessaging", "webNavigation", "storage", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "MIRAGE", "default_popup": "popup.html" },
  "options_page": "options.html",
  "web_accessible_resources": [{ "resources": ["warning.html", "warning.js", "page.css"], "matches": ["http://*/*", "https://*/*"] }]
}
