{
  "name": "lynceus-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Lynceus browser extension (Manifest V3)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node build.mjs && vitest run --config vitest.e2e.config.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
