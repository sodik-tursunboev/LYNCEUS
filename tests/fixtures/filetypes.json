{
  "comment": "Shared by tests/unit/test_filetype_fixtures.py (core/sandbox/guest/filetype.py) and agent/Lynceus.Agent.Tests (FileSignatures.cs). A case is the bytes of 'hex' (space-separated, so a secret scanner does not mistake them for keys) (or the UTF-8 of 'text') placed at offset 'at' in a zero-filled buffer of at least 'at' + length bytes. 'expect' is the type name or null. Change one detector and the other test fails until both agree.",
  "cases": [
    {"name": "pdf", "hex": "25 50 44 46 2d 31 2e 37 0a", "expect": "pdf"},
    {"name": "zip local header", "hex": "50 4b 03 04 72 65 73 74", "expect": "zip"},
    {"name": "zip empty archive", "hex": "50 4b 05 06", "expect": "zip"},
    {"name": "rar", "hex": "52 61 72 21 1a 07 00", "expect": "rar"},
    {"name": "7z", "hex": "37 7a bc af 27 1c", "expect": "7z"},
    {"name": "gzip", "hex": "1f 8b 08", "expect": "gz"},
    {"name": "bzip2", "hex": "42 5a 68 39", "expect": "bz2"},
    {"name": "xz", "hex": "fd 37 7a 58 5a 00", "expect": "xz"},
    {"name": "exe", "hex": "4d 5a 90 00 03 00", "expect": "exe"},
    {"name": "elf", "hex": "7f 45 4c 46", "expect": "elf"},
    {"name": "ole", "hex": "d0 cf 11 e0 a1 b1 1a e1", "expect": "ole"},
    {"name": "rtf", "text": "{\\rtf1\\ansi", "expect": "rtf"},
    {"name": "png", "hex": "89 50 4e 47 0d 0a 1a 0a", "expect": "png"},
    {"name": "jpeg", "hex": "ff d8 ff e0", "expect": "jpeg"},
    {"name": "gif", "text": "GIF89a", "expect": "gif"},
    {"name": "bmp", "text": "BM", "expect": "bmp"},
    {"name": "tiff little endian", "hex": "49 49 2a 00", "expect": "tiff"},
    {"name": "tiff big endian", "hex": "4d 4d 00 2a", "expect": "tiff"},
    {"name": "lnk", "hex": "4c 00 00 00 01 14 02 00 00 00 00 00", "expect": "lnk"},
    {"name": "webp", "hex": "52 49 46 46 00 00 00 00 57 45 42 50 56 50 38 20", "expect": "webp"},
    {"name": "riff that is not webp", "hex": "52 49 46 46 00 00 00 00 57 41 56 45 20 20", "expect": null},
    {"name": "iso at its offset", "at": 32769, "hex": "43 44 30 30 31", "expect": "iso"},
    {"name": "iso signature one byte early", "at": 32768, "hex": "43 44 30 30 31", "expect": null},
    {"name": "tar at its offset", "at": 257, "hex": "75 73 74 61 72", "expect": "tar"},
    {"name": "html doctype", "text": "<!DOCTYPE html><html>", "expect": "html"},
    {"name": "html after whitespace", "text": "  \n\t<html><body>", "expect": "html"},
    {"name": "html after a byte order mark", "hex": "ef bb bf 3c 68 74 6d 6c 3e", "expect": "html"},
    {"name": "html in capitals", "text": "<HTML><BODY>", "expect": "html"},
    {"name": "html script first", "text": "<script>1</script>", "expect": "html"},
    {"name": "svg inside an xml prologue", "text": "<?xml version=\"1.0\"?><svg xmlns=\"http://www.w3.org/2000/svg\"/>", "expect": "svg"},
    {"name": "svg found anywhere in the first 512 bytes", "at": 100, "text": "<svg", "expect": "svg"},
    {"name": "svg after the first 512 bytes is not seen", "at": 600, "text": "<svg", "expect": null},
    {"name": "plain words", "text": "just some words", "expect": null},
    {"name": "empty", "text": "", "expect": null},
    {"name": "one byte", "text": "P", "expect": null},
    {"name": "pdf magic not at the start", "at": 1, "hex": "25 50 44 46 2d", "expect": null},
    {"name": "a lone M", "text": "M", "expect": null}
  ]
}
